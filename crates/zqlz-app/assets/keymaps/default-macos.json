[
  {
    "bindings": {
      "cmd-,": "zqlz::OpenSettings",
      "cmd-q": "zqlz::Quit",
      "cmd-r": "zqlz::Refresh",
      "cmd-shift-p": "zqlz::OpenCommandPalette",
      "cmd-k": "zqlz::OpenCommandPalette"
    }
  },
  {
    "context": "MainView",
    "bindings": {
      "cmd-n": "zqlz::NewQuery",
      "cmd-shift-n": "zqlz::NewWindow",
      "cmd-alt-n": "zqlz::NewConnection",
      "cmd-enter": "zqlz::ExecuteQuery",
      "cmd-b": "zqlz::ToggleLeftSidebar",
      "cmd-shift-b": "zqlz::ToggleRightSidebar",
      "cmd-j": "zqlz::ToggleBottomPanel",
      "cmd-1": "zqlz::FocusSidebar",
      "cmd-2": "zqlz::FocusEditor",
      "cmd-3": "zqlz::FocusResults",
      "cmd-4": "zqlz::ShowSchemaInspector",
      "cmd-5": "zqlz::ShowCellEditorInspector",
      "cmd-6": "zqlz::ShowKeyEditorInspector",
      "cmd-7": "zqlz::ShowQueryHistoryInspector",
      "cmd-]": "tabs::ActivateNextTab",
      "cmd-[": "tabs::ActivatePrevTab",
      "cmd-alt-left": "tabs::NavigateTabBack",
      "cmd-alt-right": "tabs::NavigateTabForward",
      "cmd-w": "tabs::CloseActiveTab",
      "cmd-shift-w": "zqlz::CloseWindow",
      "cmd-alt-shift-w": "tabs::CloseOtherTabs",
      "cmd-alt-w": "tabs::CloseAllTabs",
      "cmd-shift-x": "zqlz::ExplainQuery",
      "cmd-alt-x": "zqlz::ExplainAnalyzeQuery"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-enter": "zqlz::ExecuteQuery",
      "ctrl-enter": "zqlz::ExecuteQuery",
      "cmd-shift-enter": "zqlz::ExecuteSelection",
      "cmd-shift-e": "zqlz::ExecuteSelection",
      "cmd-shift-x": "zqlz::ExplainQuery",
      "cmd-alt-x": "zqlz::ExplainAnalyzeQuery",
      "cmd-ctrl-shift-x": "zqlz::ExplainSelection",
      "cmd-ctrl-alt-x": "zqlz::ExplainAnalyzeSelection",
      "cmd-.": "editor::TriggerCompletion",
      "cmd-shift-f": "editor::FormatSQL",
      "cmd-s": "query_editor::SaveQuery",
      "cmd-shift-s": "query_editor::SaveQueryAs",
      "ctrl-space": "editor::TriggerCompletion",
      "ctrl-alt-space": "editor::TriggerCompletion",
      "cmd-i": "query_editor::ShowHover",
      "cmd-shift-space": "query_editor::TriggerParameterHints",
      "f12": "editor::GoToDefinition",
      "shift-f12": "editor::FindReferences",
      "f2": "editor::RenameSymbol",
      "f1": "query_editor::ShowHover",
      "f8": "query_editor::NextProblem",
      "shift-f8": "query_editor::PreviousProblem",
      "cmd-shift-m": "query_editor::ToggleProblemsPanel",
      "cmd-shift-.": "query_editor::ShowCodeActions",
      "cmd-escape": "zqlz::StopQuery"
    }
  },
  {
    "context": "TextEditor",
    "bindings": {
      "cmd-s": "query_editor::SaveQuery",
      "cmd-shift-s": "query_editor::SaveQueryAs"
    }
  },
  {
    "context": "TableViewerPanel",
    "bindings": {
      "cmd-s": "table_viewer::CommitChanges",
      "cmd-e": "table_viewer::OpenRowEditor",
      "cmd-a": "table_viewer::SelectAllSelection",
      "cmd-c": "table_viewer::CopySelection",
      "cmd-v": "table_viewer::PasteClipboard",
      "cmd-x": "table_viewer::CutSelection",
      "escape": "table_viewer::CancelCellEditing",
      "up": "table_viewer::SelectColumnVisibilityPrevious",
      "down": "table_viewer::SelectColumnVisibilityNext",
      "enter": "table_viewer::ToggleSelectedColumnVisibility",
      "backspace": "table_viewer::DeleteSelectedRows",
      "delete": "table_viewer::DeleteSelectedRows",
      "cmd-z": "table_viewer::UndoEdit",
      "cmd-shift-z": "table_viewer::RedoEdit",
      "cmd-f": "table_viewer::ToggleSearch",
      "cmd-h": "table_viewer::ToggleReplace"
    }
  },
  {
    "context": "CellEditorPanel",
    "bindings": {
      "cmd-s": "cell_editor::SaveCellEdit",
      "cmd-enter": "cell_editor::SaveCellEdit",
      "ctrl-enter": "cell_editor::SaveCellEdit",
      "escape": "cell_editor::CancelCellEdit",
      "cmd-shift-f": "cell_editor::FormatCellEdit",
      "alt-z": "cell_editor::ToggleCellEditorWordWrap"
    }
  },
  {
    "context": "ConnectionSidebar",
    "bindings": {
      "enter": "connection_sidebar::ActivateConnection",
      "backspace": "connection_sidebar::DeleteSelectedConnection",
      "shift-f10": "connection_sidebar::ShowContextMenu"
    }
  },
  {
    "context": "ObjectsPanel",
    "bindings": {
      "enter": "objects_panel::OpenSelected",
      "backspace": "objects_panel::DeleteSelected",
      "delete": "objects_panel::DeleteSelected",
      "cmd-n": "objects_panel::NewObject"
    }
  }
]
